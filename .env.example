# Studio BFF settings (docs/features/sign-in.md). Copy to .env; .env is git-ignored.
# Local stack: synthwerk-infra writes the client id and secret to studio-client.json
# in the zitadel-admin volume. Never commit a real secret.
NUXT_OIDC_ISSUER=http://auth.localhost:8080
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
NUXT_OIDC_PROJECT_ID=
NUXT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
NUXT_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# true = refuse a sign-in whose access token amr has no mfa (needs synthwerk-identity#15).
NUXT_OIDC_REQUIRE_MFA=false
NUXT_SESSION_MAX_AGE_SECONDS=28800
# At least 32 random characters, for example: openssl rand -base64 48
NUXT_SESSION_SECRET=
# Pulse inside the network for the health view (docs/features/health-view.md). Local stack
# outside compose: the edge route http://127.0.0.1:8080/pulse. Empty = health view off (503).
NUXT_PULSE_BASE_URL=
# Apps and the embed snippet (docs/features/apps-and-embed.md).
# Identity as the studio server reaches it. Local stack: through the edge.
NUXT_IDENTITY_URL=http://localhost:8080/identity
# Where the widget script is served, and the edge the widget calls (/identity, /llm).
NUXT_PUBLIC_WIDGET_SCRIPT_URL=http://localhost:4174/dist/synthwerk-chat.js
NUXT_PUBLIC_WIDGET_API_URL=http://localhost:8080
